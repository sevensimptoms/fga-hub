<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Profile | FGA-HUB</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body {
      background-color: #0d0d0d;
      color: #fff;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .banner {
      height: 220px;
      background: url('https://cdn.pixabay.com/photo/2020/04/22/14/04/texture-5078885_1280.jpg') center/cover no-repeat;
      position: relative;
    }

    .profile-pic {
      width: 140px;
      height: 140px;
      object-fit: cover;
      border-radius: 50%;
      border: 4px solid #0d0d0d;
      position: absolute;
      bottom: -70px;
      left: 50%;
      transform: translateX(-50%);
      background-color: #fff;
    }

    .profile-info {
      text-align: center;
      margin-top: 90px;
    }

    .profile-info h3 {
      margin-bottom: 0;
    }

    .username {
      color: #aaa;
      font-size: 0.9rem;
    }

    .bio {
      color: #ccc;
      margin-top: 10px;
    }

    .stats {
      margin-top: 20px;
      color: #bbb;
    }

    .stats span {
      margin: 0 15px;
    }

    .nav-tabs .nav-link {
      background-color: #1a1a1a;
      color: #bbb;
      border: none;
    }

    .nav-tabs .nav-link.active {
      background-color: #333;
      color: #fff;
    }

    .tab-content {
      background-color: #1a1a1a;
      padding: 1.5rem;
      border-radius: 12px;
      margin-top: 1rem;
    }

    .card {
      background-color: #2a2a2a;
      border: none;
    }
  </style>
</head>
<body>

  <div class="banner">
    <img src="https://cdn.pixabay.com/photo/2022/12/25/04/36/dante-7676805_1280.jpg" alt="Profile Picture" class="profile-pic">
  </div>

  <div class="container profile-info">
    <!-- <h3>Kaziri Oshiomhole</h3> -->
    <div class="username">@dante_spader</div>
    <div class="bio"><%= user.bio %></div>
    <div class="stats">
      <span><strong>120</strong> Posts</span>
      <span><strong>5.2k</strong> Followers</span>
      <span><strong>180</strong> Following</span>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs justify-content-center mt-4" id="profileTab" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="posts-tab" data-bs-toggle="tab" data-bs-target="#posts" type="button" role="tab">Posts</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="about-tab" data-bs-toggle="tab" data-bs-target="#about" type="button" role="tab">About</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings" type="button" role="tab">Settings</button>
      </li>
    </ul>

    <div class="tab-content" id="profileTabContent">
      <div class="tab-pane fade show active" id="posts" role="tabpanel">
        <div class="row g-3">
          <div class="col-md-4">
            <div class="card p-3">
              <img src="https://cdn.pixabay.com/photo/2025/04/22/05/54/dog-9548923_1280.jpg" class="img-fluid rounded" alt="Post">
              <small class="text-muted mt-2 d-block">Posted 2 days ago</small>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card p-3">
              <img src="https://cdn.pixabay.com/photo/2023/12/15/20/04/ai-generated-8452097_1280.jpg" class="img-fluid rounded" alt="Post">
              <small class="text-muted mt-2 d-block">Posted 1 week ago</small>
            </div>
          </div>
        </div>
      </div>

      <div class="tab-pane fade" id="about" role="tabpanel">
        <p>Kaziri is a digital creator focused on experimental photography and stylized AI art. Known for his sharp eye and storytelling through visual media.</p>
      </div>

      <div class="tab-pane fade" id="settings" role="tabpanel">
        <p>This is where profile settings would go.</p>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
